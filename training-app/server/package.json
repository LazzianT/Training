{
  "name": "@training/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "migration:dry": "tsx scripts/migrate-legacy.ts",
    "migration:apply": "tsx scripts/migrate-legacy.ts"
  },
  "dependencies": {
    "@training/contracts": "workspace:*",
    "cors": "2.8.6",
    "dotenv": "18.0.3",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "mssql": "12.7.2",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
