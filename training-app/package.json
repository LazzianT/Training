{
  "name": "training-app",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @training/client --filter @training/server dev",
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm --filter @training/contracts build && corepack pnpm -r typecheck",
    "lint": "corepack pnpm exec eslint .",
    "test": "corepack pnpm -r test",
    "audit": "corepack pnpm audit --prod",
    "migration:dry": "corepack pnpm --filter @training/server migration:dry",
    "migration:apply": "corepack pnpm --filter @training/server migration:apply"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
