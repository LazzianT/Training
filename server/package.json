{
  "name": "@training/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "vitest run --passWithNoTests",
    "migration:dry": "node scripts/migrate-legacy.js",
    "migration:apply": "node scripts/migrate-legacy.js",
    "migrate:data": "node scripts/import-legacy-data.js",
    "migrate:check": "node scripts/validate-legacy.js",
    "migrate:reset": "node scripts/reset-training-data.js",
    "db:probe": "node scripts/db-probe.js"
  },
  "dependencies": {
    "@training/contracts": "workspace:*",
    "cors": "2.8.6",
    "dotenv": "18.0.3",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.2",
    "mssql": "12.7.2",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "vitest": "5.0.1"
  }
}
