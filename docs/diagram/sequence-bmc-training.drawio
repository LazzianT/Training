        <mxCell id="m1" value="1. Memindai QR code di layar acara" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" source="a1" target="a2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="2. GET /api/assessment/access/:token" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" source="act2" target="act3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="3. Hash token (SHA-256),&#10;cek kadaluwarsa + used_count" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" source="act3" target="act4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="4. SELECT dari training_qr_access&#10;WHERE token_hash = @hash" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" source="act4" target="a6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="5. { eventId, purpose, judul, tgl, ruang }" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;dashed=1;fontSize=9;" edge="1" source="a6" target="act2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="6. Menampilkan identitas acara,&#10;lalu meminta NIP" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" source="a2" target="a1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="alt1" value="alt [QR tidak berlaku / kadaluwarsa]" style="shape=umlAlt;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;fontSize=10;fontStyle=1;verticalAlign=top;verticalSpacing=-2;startSize=22;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="410" y="300" width="600" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="7. 404 QR_EXPIRED" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;dashed=1;fontSize=9;strokeColor=#b85450;" edge="1" source="act3" target="a2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="alt2" value="alt [NIP masuk &#8212; verifikasi kelayakan]" style="shape=umlAlt;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;dashed=1;fontSize=10;fontStyle=1;verticalAlign=top;verticalSpacing=-2;startSize=22;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="410" y="420" width="600" height="160" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="8. Mengetik NIP" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#d6b656;" edge="1" source="a1" target="a2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m9" value="9. POST /access/:token/open&#10;{ nip }" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#d6b656;" edge="1" source="act2" target="act3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m10" value="10. publicContext(token, nip)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#d6b656;" edge="1" source="act3" target="act4b" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m11" value="11. Cek NIP terdaftar di&#10;training_peserta_acara (du-tolerant)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#d6b656;" edge="1" source="act4b" target="act6b" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m12" value="12. Cari set soal&#10;status = published" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#d6b656;" edge="1" source="act4b" target="act6c" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m13" value="13. EXISTS sesi&#10;submitted/locked?" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#d6b656;" edge="1" source="act4b" target="act6c" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m14" value="14. 403 PARTICIPANT_NOT_FOUND&#10;atau 409 TEST_NOT_PUBLISHED / ALREADY_SUBMITTED" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;dashed=1;fontSize=9;strokeColor=#b85450;" edge="1" source="act3" target="a2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="alt3" value="alt [layak &#8212; kirim soal]" style="shape=umlAlt;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;fontSize=10;fontStyle=1;verticalAlign=top;verticalSpacing=-2;startSize=22;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="410" y="600" width="600" height="240" as="geometry" />
        </mxCell>
        <mxCell id="m15" value="15. SELECT id, question_no, question_text,&#10;option_a..d&#10;&#10006; correct_answer TIDAK ikut dipilih" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#82b366;" edge="1" source="act3" target="a6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m16" value="16. Daftar soal (tanpa kunci)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;dashed=1;fontSize=9;strokeColor=#82b366;" edge="1" source="a6" target="a2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m17" value="17. Peserta menjawab 10 soal" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#82b366;" edge="1" source="a1" target="a2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m18" value="18. POST /access/:token/submit&#10;{ nip, answers: [{ questionId, answer }] }" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#82b366;" edge="1" source="act2" target="act3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m19" value="19. submitPublicAssessment()" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#82b366;" edge="1" source="act3" target="act5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m20" value="20. MERGE training_test_session&#10;status = submitted,&#10;submitted_at = SYSUTCDATETIME()" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#82b366;" edge="1" source="act5" target="a6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m21" value="21. MERGE training_answer_pg&#10;(per nomor soal)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#82b366;" edge="1" source="act5" target="a6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m22" value="22. MERGE training_answer_grade_pg&#10;Nilai dihitung SERVER:&#10;score = point bila benar, 0 bila salah" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#82b366;" edge="1" source="act5" target="a6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m23" value="23. { sessionId }" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;dashed=1;fontSize=9;strokeColor=#82b366;" edge="1" source="a6" target="act5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m24" value="24. 201 Created" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;strokeColor=#82b366;" edge="1" source="act3" target="a2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m25" value="25. Thank you &#8212; jawaban terkunci" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#82b366;" edge="1" source="a2" target="a1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="Tiga keputusan desain yang terlihat pada diagram ini:&#10;&#10;1. PESERTA TIDAK LOGIN. Identitas divalidasi dengan NIP yang dicocokkan terhadap&#10;   training_peserta_acara. Ini membuat participation friction rendah, sesuai&#10;  Requirement US-004, sekaligus tetap membatasi akses hanya untuk peserta terdaftar.&#10;&#10;2. KUNCI JAWABAN TIDAK PERNAH KELUAR KE CLIENT. Kolom correct_answer tidak&#10;   ada di SELECT pada langkah 15 &#8594; SRS.md QST-013 terpenuhi. Nilai dihitung&#10;   server pada langkah 22, sehingga peserta tidak bisa menebak atau memanipulasi skor.&#10;&#10;3. PESERTA TIDAK BOLEH MENGIRIM ULANG. Pengecekan sesi pada langkah 13 membuat&#10;   percobaan kedua menghasilkan 409 ALREADY_SUBMITTED." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="410" y="880" width="880" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Known Issue (BUG-002 &#183; BUG-003):&#10;&#10;&#8226; Langkah 20-22 dijalankan sebagai query terpisah TANPA transaksi.&#10;  Bila proses terhenti di tengah, sesi bisa berstatus submitted&#10;  padahal jawaban belum lengkap tersimpan.&#10;&#8216;&#10;&#8226; Langkah 21 memakai WHEN MATCHED THEN UPDATE, sehingga&#10;  jalur update isi jawaban masih ada &#8212; bertentangan dengan&#10;  SRS.md QST-011 / QST-012 yang mewajibkan jawaban&#10;  tidak dapat diubah setelah submit. Diperbaiki pada Sprint 7." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="410" y="1090" width="880" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

