        <mxCell id="m3" value="3. POST /access/:token/attendance&#10;{ nip, signatureData }" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" source="act2" target="act3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="4. Zod: regex /^data:image\/(png|jpeg);base64,/&#10;+ batas ukuran 2 MB" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" source="act3" target="act3" parent="1">
