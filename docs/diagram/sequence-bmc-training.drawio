        <mxCell id="m2" value="2. Mengetik NIP, lalu&#10;menggambar tanda tangan di canvas" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" source="a1" target="a2" parent="1">
