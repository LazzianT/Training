        <mxCell id="p1" value="BAGIAN A &#8212; ABSENSI (UC-14)" style="text;html=1;strokeColor=none;fillColor=#f8cecc;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
