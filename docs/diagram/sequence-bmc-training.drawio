        <mxCell id="p2" value="BAGIAN B &#8212; FEEDBACK PESERTA (UC-23)" style="text;html=1;strokeColor=none;fillColor=#dae8fc;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="465" width="400" height="20" as="geometry" />
        </mxCell>

        <mxCell id="m13" value="13. Memindai QR feedback,&#10;mengisi 14 aspek (skala 1-5)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" source="a1" target="a2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m14" value="14. POST /access/:token/feedback&#10;{ nip, entries: [{ aspect, score, comment }] }" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" source="act2" target="act3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m15" value="15. Zod: score 1-5,&#10;entries min 1 max 50" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" source="act3" target="act3" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="430" y="560" /><mxPoint x="430" y="590" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m16" value="16. publicContext():&#10;NIP peserta + belum feedback?" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" source="act3" target="act4b" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m17" value="17. EXISTS di training_feedback" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" source="act4b" target="a6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m18" value="18. { access, participantNip }" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;dashed=1;fontSize=9;" edge="1" source="a6" target="act4b" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m19" value="19. submitFeedback()" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" source="act3" target="act5b" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m20" value="20. MERGE training_feedback&#10;1 baris per aspek&#10;feedback_type = 'user'&#10;CHECK score BETWEEN 1 AND 5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" source="act5b" target="act6b" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m21" value="21. 201 Created { saved: 14 }" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" source="act3" target="a2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m22" value="22. Terima kasih atas penilaiannya" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" source="a2" target="a1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="altB" value="alt [sudah pernah mengisi feedback]" style="shape=umlAlt;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;fontSize=10;fontStyle=1;verticalAlign=top;verticalSpacing=-2;startSize=22;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="440" y="640" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m23" value="23. 409 ALREADY_SUBMITTED" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;dashed=1;fontSize=9;strokeColor=#b85450;" edge="1" source="act3" target="a2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="Timestamps dari server, bukan dari browser&#10;&#10;Kolom captured_at dan submitted_at diisi dengan&#10;SYSUTCDATETIME() di dalam SQL. Ini penting karena&#10;jam perangkat peserta bisa salah, tidak sinkron, atau&#10;diubah dengan sengaja &#8212; terutama pada perangkat seluler&#10;yang sering kehilangan sinkronisasi waktu.&#10;&#10;Pemenuhan: SRS.md ATT-006." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="760" width="380" height="160" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Known Issue (BUG-001):&#10;&#10;PRD.md dan SRS.md ATT-003 s.d. ATT-005 mensyaratkan&#10;absensi dengan FOTO (upload file), sedangkan implementasi&#10;saat ini memakai tanda tangan gambar vektor.&#10;&#10;Konsekuensinya:&#10;&#8226; Tidak ada validasi MIME / magic byte / dimensi&#10;&#8226; Tidak ada volume upload / pembatasan ukuran berkas&#10;&#8226; Kolom photo_path berisi teks konstanta&#10;  &#39;online-signature&#39;, bukan path berkas&#10;&#8226; SRS.md SEC-006 / SEC-007 belum terpenuhi" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="470" y="740" width="440" height="180" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Catatan desain basis data:&#10;&#10;&#8226; Tabel feedback disimpan melebar (1 baris per aspek),&#10;  bukan 1 baris per peserta. Ini memungkinkan perhitungan&#10;  rata-rata per aspek langsung di SQL dan mendukung&#10;  UMPAN BALIK TRAINER di masa depan melalui kolom&#10;  feedback_type yang sudah ada di skema.&#10;&#10;&#8226; Kolom feedback_type sudah mendukung nilai &#39;trainer&#39;,&#10;  namun endpoint publik masih menulis &#39;user&#39; secara hardcoded." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="940" y="760" width="440" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
