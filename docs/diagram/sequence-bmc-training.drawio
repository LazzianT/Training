          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="Pencegahan duplikasi berlapis:&#10;&#8226; &#37;1&#37; di server &#8212; Set() menghapus NIP ganda pada array yang dikirim&#10;&#8226; &#37;2&#37; di query &#8212; NOT EXISTS terhadap training_peserta_acara&#10;&#8226; &#37;3&#37; di database &#8212; UNIQUE (event_id, participant_nip)&#10;&#8226; &#37;4&#37; di respons &#8212; admin diberi tahu berapa yang dilewati (skipped), bukan diam-diam gagal" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1050" y="600" width="560" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Mengapa snapshot nama dan departemen?&#10;&#10;Kolom participant_name, department_code, dan department_name&#10;disalin saat peserta ditambahkan. Alasannya:&#10;&#8226; Laporan lama tetap terbaca meskipun karyawan pindah&#10;  departemen atau sudah tidak aktif di HRIS&#10;&#8226; Tidak ada query tambahan ke hris_Employee saat membuka laporan&#10;&#8226; hris_Employee tetap sepenuhnya READ-ONLY &#8212; tidak ada satu pun&#10;  penulisan ke tabel existing (todo.md &#167;Guardrail Data)" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="480" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Catatan: hris_EmployeeCareerPath (jabatan) disyaratkan oleh&#10;SRS.md EMP-004 dan US-002, namun belum dipakai pada endpoint ini &#8212; backlog." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="580" y="770" width="430" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
