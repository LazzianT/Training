        <mxCell id="m8" value="8. submitAttendance()" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" source="act3" target="act5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m9" value="9. INSERT training_absensi&#10;photo_path = 'online-signature'&#10;captured_at = SYSUTCDATETIME()&#10;UNIQUE (event_id, participant_nip)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" source="act5" target="act6" parent="1">
