        </mxCell>
        <mxCell id="m11" value="11. createEvent(data, actor.nip)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#82b366;" edge="1" source="act3" target="act5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m12" value="12. SET XACT_ABORT ON; BEGIN TRAN; &#10;INSERT training_acara &#8594; OUTPUT INSERTED.id" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#82b366;" edge="1" source="act5" target="a6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m13" value="13. INSERT training_acara_trainer&#10;INTERNAL: ambil NIP + Name dari hris_Employee&#10;EXTERNAL: trainer_nip = NULL" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#82b366;" edge="1" source="act5" target="a6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m14" value="14. CHECK constraint tervalidasi&#10;(waktu, ruang_id FK, trainer_nip)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;dashed=1;fontSize=9;strokeColor=#82b366;" edge="1" source="a6" target="act5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m15" value="15. COMMIT TRAN &#8594; id acara baru" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;dashed=1;fontSize=9;strokeColor=#82b366;" edge="1" source="a6" target="act5" parent="1">
