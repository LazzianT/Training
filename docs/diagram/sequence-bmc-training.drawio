          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m18" value="18. Redirect ke /events/:id" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#82b366;" edge="1" source="a2" target="a1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="Catatan implementasi:&#10;&#8226; Kedua INSERT berada dalam SATU transaksi &#8212; bila insert pengisi acara gagal, acara ikut batal (XACT_ABORT ON).&#10;&#8226; Seluruh nilai dikirim sebagai parameter mssql ber-type (tidak ada interpolasi string) &#8594; aman dari SQL injection.&#10;&#8226; NIP dinormalisasi dari hris_Employee sehingga penulisan manual tidak mungkin terjadi untuk trainer internal." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="920" y="600" width="620" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Pembedaan pengisi acara (PRD.md &#167;12 butir 1, US-011):&#10;&#8226; INTERNAL &#8594; dipilih dari hris_Employee; kolom trainer_nip terisi &#8594;sehingga role isEventTrainer turun otomatis&#10;&#8226; EXTERNAL &#8594; input manual; trainer_nip NULL &#8594; TIDAK bisa login (memang tidak punya akun)&#10;&#8226; CHECK constraint di 001_training_schema.sql:65-70 menjaga konsistensi ini di level database" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="420" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

