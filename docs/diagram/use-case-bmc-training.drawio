        <mxCell id="notePeserta" value="Catatan &#8212; akses peserta:&#10;Peserta TIDAK melakukan login. Identitas divalidasi&#10;dengan mengetik NIP pada halaman QR publik, lalu&#10;dicocokkan ke training_peserta_acara. Endpoint&#10;/api/assessment/access/* berada di luar middleware&#10;authenticate (assessment.routes.js:21-74)." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1040" y="935" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="noteData" value="Batas keamanan data (todo.md &#167;Guardrail Data):&#10;&#8226; Tabel hris_* = READ-ONLY, tidak pernah diubah&#10;&#8226; Semua tabel aplikasi baru berawalan training_&#10;&#8226; ALTER / DROP / DELETE wajib persetujuan DBA&#10;&#8226; Migrasi legacy hanya membaca sumber, menulis ke target" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1040" y="1080" width="330" height="120" as="geometry" />
